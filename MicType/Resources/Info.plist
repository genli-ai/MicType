<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>zh_CN</string>
	<key>CFBundleDisplayName</key>
	<string>MicType</string>
	<key>CFBundleExecutable</key>
	<string>MicType</string>
	<key>CFBundleIconFile</key>
	<string>AppIcon</string>
	<key>CFBundleIdentifier</key>
	<string>com.ligen.mictype</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>MicType</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>3.3.0</string>
	<key>CFBundleVersion</key>
	<string>29</string>
	<key>LSMinimumSystemVersion</key>
	<string>15.0</string>
	<key>LSUIElement</key>
	<true/>
	<!-- 本机模型（Ollama 11434 / LM Studio 1234）走明文 http://localhost：
	     ATS 默认会拦掉它，而 ad-hoc 调试构建看不出这个问题，签名构建才暴露。
	     公网仍然一律 https。

	     注意这条例外的**真实范围**：NSAllowsLocalNetworking 放行的是整个本地网络
	     ——回环、*.local（mDNS）、link-local、RFC1918 私网段，不只是 localhost。
	     它无法收窄：ATS 的 NSExceptionDomains 不接受 IP 字面量，换成
	     localhost 的例外域就会把 http://127.0.0.1 一起拦掉。
	     所以"只发给本机"这条纪律由 App 自己守：LLMCatalog.isLocalHost 只认回环地址，
	     LLMClient.dispatch / fetchModelIDs 会拒绝明文发往非回环主机。 -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>NSHighResolutionCapable</key>
	<true/>
	<key>NSMicrophoneUsageDescription</key>
	<string>MicType 需要使用麦克风把你的语音转换成文字。语音识别完全在本机进行，录音不会上传。</string>
	<key>NSPrincipalClass</key>
	<string>NSApplication</string>
</dict>
</plist>
